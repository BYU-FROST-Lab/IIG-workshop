---
import organizerOne from "../../images/organizers/brady_moon.jpg";
import organizerTwo from "../../images/organizers/elijah_pettitt.jpg";
import organizerThree from "../../images/organizers/guillaume_sartoretti.png";
import organizerFour from "../../images/organizers/muqing_cao.png";
import organizerFive from "../../images/organizers/seungchan_kim.png";
import organizerSix from "../../images/organizers/shenghai_yuan.png";
import organizerSeven from "../../images/organizers/yuhong_cao.webp";

const organizers = [
  {
    image: organizerSix,
    name: "Shenghai Yuan",
    website: "https://snakehaihai.github.io",
    email: "shyuan@ntu.edu.sg",
  },
  {
    image: organizerTwo,
    name: "Elijah Pettitt",
    website: "https://frostlab.byu.edu",
    email: "epettitt@byu.edu",
    corresponding: true,
  },
  {
    image: organizerFour,
    name: "Muqing Cao",
    website: "https://caomuqing.github.io",
    email: "muqingc@andrew.cmu.edu",
  },
  {
    image: organizerFive,
    name: "Seungchan Kim",
    website: "https://seungchan-kim.github.io",
    email: "seungch2@andrew.cmu.edu",
  },
  {
    image: organizerSeven,
    name: "Cao Yuhong",
    website: "https://yuhongcao.online",
    email: "caoyuhong@u.nus.edu",
  },
  {
    image: organizerThree,
    name: "Guillaume Sartoretti",
    website: "https://marmotlab.org",
    email: "guillaume.sartoretti@nus.edu.sg",
  },
  {
    image: organizerOne,
    name: "Brady Moon",
    website: "https://bradymoon.com",
    email: "brady.moon@byu.edu",
  },
];
---

<section
  id="organizers"
  aria-labelledby="organizers-title"
  class="relative isolate overflow-hidden bg-[linear-gradient(180deg,_#ffffff_0%,_#f8fafc_42%,_#eef2ff_100%)] py-20 text-slate-900 sm:py-24"
>
  <div class="absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-slate-300 to-transparent"></div>
  <div class="absolute left-[-7rem] top-16 -z-10 h-72 w-72 rounded-full bg-cyan-300/15 blur-3xl"></div>
  <div class="absolute right-[-8rem] top-24 -z-10 h-80 w-80 rounded-full bg-violet-300/15 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-10">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.32em] text-cyan-700/80">
        Behind the Workshop
      </p>
      <h2
        id="organizers-title"
        class="mt-4 text-4xl font-semibold tracking-[-0.05em] text-balance text-slate-950 sm:text-5xl"
      >
        Organizers
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
        Our committee members bring extensive experience from past workshops and competitions at conferences including IROS, ICRA, AAAI, and CDC.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
      {organizers.map((organizer) => (
        <article class:list={[
          "group relative overflow-hidden rounded-[2rem] border bg-slate-950 shadow-[0_30px_80px_-40px_rgba(15,23,42,0.22)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_40px_95px_-45px_rgba(15,23,42,0.28)]",
          organizer.corresponding ? "border-cyan-300/70 ring-1 ring-cyan-300/50" : "border-slate-200/80",
        ]}>
          <div class="relative h-[28rem]">
            <img
              src={organizer.image.src}
              alt={`${organizer.name} portrait`}
              class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,_rgba(15,23,42,0.02)_0%,_rgba(15,23,42,0.18)_38%,_rgba(15,23,42,0.92)_100%)]"></div>

            {organizer.corresponding && (
              <div class="absolute left-4 top-4 h-3 w-3 rounded-full bg-cyan-300 shadow-[0_0_0_8px_rgba(103,232,249,0.18)]"></div>
            )}

            <div class="absolute inset-x-0 bottom-0 p-5">
              <h3 class="text-2xl font-semibold tracking-[-0.03em] text-white">
                {organizer.name}
              </h3>

              <div class="mt-4 flex items-center gap-3">
                <a
                  href={organizer.website}
                  class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/10 text-white/90 backdrop-blur transition hover:bg-white/20 hover:text-white"
                  aria-label={`Visit ${organizer.name}'s website`}
                  target="_blank"
                  rel="noreferrer"
                >
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 21a9 9 0 1 0-9-9" />
                    <path d="M3 12h18" />
                    <path d="M12 3c2.5 2.7 4 5.7 4 9s-1.5 6.3-4 9c-2.5-2.7-4-5.7-4-9s1.5-6.3 4-9Z" />
                  </svg>
                </a>
                <a
                  href={`mailto:${organizer.email}`}
                  class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/10 text-white/90 backdrop-blur transition hover:bg-white/20 hover:text-white"
                  aria-label={`Email ${organizer.name}`}
                >
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
