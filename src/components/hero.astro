              <p class="mt-1 text-sm leading-6 text-slate-300">
                Add the real submission, notification, and registration dates here when they are confirmed.
              </p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4">
              <p class="text-sm font-semibold text-white">Program block</p>
              <p class="mt-1 text-sm leading-6 text-slate-300">
                Add speakers, accepted papers, and competition details once the schedule is finalized.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
