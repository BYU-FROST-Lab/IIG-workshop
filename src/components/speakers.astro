---
import boyuZhou from "../../images/speakers/boyu_zhou.png";
import jenJenChung from "../../images/speakers/jen_jen_chung.png";
import kostasAlexis from "../../images/speakers/kostas_alexis.png";
import marijaPopovic from "../../images/speakers/marija_popovic.png";
import michaelKaess from "../../images/speakers/michael_kaess.png";
import sebastianScherer from "../../images/speakers/sebastian_scherer.png";

const speakers = [
  {
    image: kostasAlexis,
    name: "Kostas Alexis",
    affiliation: "Norwegian University of Science and Technology, Norway",
  },
  {
    image: jenJenChung,
    name: "Jen Jen Chung",
    affiliation: "The University of Queensland, Australia",
  },
  {
    image: sebastianScherer,
    name: "Sebastian Scherer",
    affiliation: "Carnegie Mellon University, USA",
  },
  {
    image: michaelKaess,
    name: "Michael Kaess",
    affiliation: "Pittsburgh startup Aquatonomy, USA",
  },
  {
    image: boyuZhou,
    name: "Boyu Zhou",
    affiliation: "Southern University of Science and Technology, China",
  },
  {
    image: marijaPopovic,
    name: "Marija Popović",
    affiliation: "Delft University of Technology, Netherlands",
  },
];
---

<section
  id="speakers"
  aria-labelledby="speakers-title"
  class="relative isolate overflow-hidden bg-[linear-gradient(180deg,_#f8fafc_0%,_#eef2ff_52%,_#ffffff_100%)] py-20 text-slate-900 sm:py-24"
>
  <div class="absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-slate-300 to-transparent"></div>
  <div class="absolute left-[-7rem] top-16 -z-10 h-72 w-72 rounded-full bg-cyan-300/15 blur-3xl"></div>
  <div class="absolute right-[-8rem] top-32 -z-10 h-80 w-80 rounded-full bg-violet-300/15 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-10">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.32em] text-cyan-700/80">
        Speakers
      </p>
      <h2
        id="speakers-title"
        class="mt-4 text-4xl font-semibold tracking-[-0.05em] text-balance text-slate-950 sm:text-5xl"
      >
        Invited Talks from Academia and Industry
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
        Invited speakers will present the latest perspectives and research in intelligent information gathering with a focus on active perception, exploration planning, and decision-making under uncertainty.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
      {speakers.map((speaker) => (
        <article class="group relative overflow-hidden rounded-[2rem] border border-slate-200/80 bg-slate-950 shadow-[0_30px_80px_-40px_rgba(15,23,42,0.75)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_40px_95px_-45px_rgba(15,23,42,0.85)]">
          <div class="relative h-[30rem]">
            <img
              src={speaker.image.src}
              alt={speaker.name}
              class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,_rgba(15,23,42,0.05)_0%,_rgba(15,23,42,0.22)_42%,_rgba(15,23,42,0.9)_100%)]"></div>

            <div class="absolute inset-x-0 bottom-0 p-5">
              <h3 class="mt-4 text-2xl font-semibold tracking-[-0.03em] text-white">
                {speaker.name}
              </h3>

              <p class="mt-2 text-sm font-medium text-slate-200/85">
                Talk Title Placeholder
              </p>

              <div class="mt-5 inline-flex rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-slate-300 backdrop-blur">
                {speaker.affiliation}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
