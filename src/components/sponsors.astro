---
import aeriseLogo from "../../images/sponsors/aerise.png";
import comarvelLogo from "../../images/sponsors/comarvel.png";

const sponsors = [
  {
    image: comarvelLogo,
    label: "Sponsor logo",
  },
  {
    image: aeriseLogo,
    label: "Sponsor logo",
  },
];
---

<section
  id="sponsors"
  aria-labelledby="sponsors-title"
  class="relative isolate overflow-hidden bg-[linear-gradient(180deg,_#ffffff_0%,_#f8fafc_52%,_#eef2ff_100%)] py-10 text-slate-900 sm:py-12"
>
  <div class="absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-slate-300 to-transparent"></div>
  <div class="absolute left-[-7rem] top-16 -z-10 h-72 w-72 rounded-full bg-cyan-300/15 blur-3xl"></div>
  <div class="absolute right-[-8rem] top-24 -z-10 h-80 w-80 rounded-full bg-violet-300/15 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-10">
    <div class="text-center">
      <h2
        id="sponsors-title"
        class="mt-2 text-3xl font-semibold tracking-[-0.05em] text-balance text-slate-950 sm:text-4xl"
      >
        Sponsors
      </h2>
    </div>

    <div class="mx-auto mt-8 grid max-w-4xl grid-cols-1 gap-4 md:grid-cols-2">
        
        <div class="flex items-center justify-center rounded-[2rem] border border-slate-200/80 bg-white px-6 py-6 shadow-[0_24px_70px_-40px_rgba(15,23,42,0.18)] sm:px-8 sm:py-7">
          <img
            src="../../images/sponsors/comarvel.png"
            alt="CMII"
            class="max-h-28 w-full object-contain sm:max-h-32"
            loading="lazy"
          />
        </div>
        
        <div class="flex items-center justify-center rounded-[2rem] border border-slate-200/80 bg-white px-6 py-6 shadow-[0_24px_70px_-40px_rgba(15,23,42,0.18)] sm:px-8 sm:py-7">
          <img
            src="../../images/sponsors/aerise.png"
            alt="Aerise"
            class="max-h-28 w-full object-contain sm:max-h-20"
            loading="lazy"
          />
        </div>

      
    </div>
  </div>
</section>
