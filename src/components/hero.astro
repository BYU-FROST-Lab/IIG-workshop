<section
  id="hero"
  aria-labelledby="hero-title"
  class="relative isolate overflow-hidden bg-slate-950 text-white"
>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,_rgba(56,189,248,0.28),_transparent_36%),radial-gradient(circle_at_top_right,_rgba(16,185,129,0.18),_transparent_30%),linear-gradient(180deg,_#020617_0%,_#0f172a_58%,_#111827_100%)]"></div>
  <div class="absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-cyan-300/50 to-transparent"></div>
  <div class="absolute left-[-8rem] top-20 -z-10 h-72 w-72 rounded-full bg-cyan-400/10 blur-3xl"></div>
  <div class="absolute right-[-7rem] top-32 -z-10 h-72 w-72 rounded-full bg-emerald-400/10 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-6 pb-20 pt-20 sm:px-8 sm:pb-24 sm:pt-24 lg:px-10 lg:pb-28 lg:pt-28">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-medium uppercase tracking-[0.28em] text-cyan-100/80 backdrop-blur">
          <span class="h-2 w-2 rounded-full bg-cyan-300"></span>
          Workshop landing page
        </div>

        <p class="mt-6 text-sm font-medium uppercase tracking-[0.32em] text-cyan-100/70">
          Conference workshop placeholder content
        </p>

        <h1
          id="hero-title"
          class="mt-5 max-w-4xl text-5xl font-semibold leading-[0.95] tracking-[-0.05em] text-balance text-white sm:text-6xl lg:text-7xl"
        >
          The Workshop and Competition on Intelligent Information Gathering for Single and Multi-Robot Systems
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 sm:text-xl">
          The event combines invited talks from academia and industry experts presenting recent progress, poster presentations for invited workshop paper submissions, and an open-source simulation competition focused on indoor exploration.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200 backdrop-blur">
            Sunday Sept 27, 8:00 - 12:30
          </div>
          <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200 backdrop-blur">
            Insert venue or conference room here
          </div>
          <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200 backdrop-blur">
            Insert submission or registration deadline here
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/competition"
            class="inline-flex items-center justify-center rounded-full bg-cyan-400 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
          >
            View competition placeholder
          </a>
          <a
            href="#hero"
            class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:border-white/25 hover:bg-white/10"
          >
            Replace with program details
          </a>
        </div>
      </div>

      <div class="lg:pl-4">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-2xl shadow-cyan-950/30 backdrop-blur-xl sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-sm font-medium uppercase tracking-[0.26em] text-cyan-100/70">
                Contributions
              </p>
              <h2 class="mt-2 text-2xl font-semibold text-white">
                Be a part of IROS 2026
              </h2>
            </div>
            <div class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-xs font-medium text-emerald-100">
              Submissions Open
            </div>
          </div>

          <div class="mt-8 space-y-4">
            <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4">
              <p class="text-sm font-semibold text-white">Overview block</p>
              <p class="mt-1 text-sm leading-6 text-slate-300">
                Use this space for a short official description of the workshop theme and goals.
              </p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4">
