---
const scheduleItems = [
  { time: "8:30 - 8:45", event: "Chair Opening Remarks" },
  { time: "8:45 - 9:10", event: "Kostas Alexis" },
  { time: "9:10 - 9:35", event: "Jen Jen Chung" },
  { time: "9:35 - 10:00", event: "Sebastian Scherer" },
  { time: "10:00 - 10:25", event: "Michael Kaess" },
  { time: "10:25 - 10:50", event: "Coffee Break and Poster Session" },
  { time: "10:50 - 11:15", event: "Boyu Zhou" },
  { time: "11:15 - 11:40", event: "Marija Popović" },
  { time: "11:40 - 12:05", event: "Challenge Champion Presentations" },
  { time: "12:05 - 12:30", event: "Panel Discussion and Conclusion" },
];
---

<section
  id="schedule"
  aria-labelledby="schedule-title"
  class="relative isolate overflow-hidden bg-[linear-gradient(180deg,_#020617_0%,_#0f172a_56%,_#111827_100%)] py-20 text-white sm:py-24"
>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,_rgba(56,189,248,0.18),_transparent_34%),radial-gradient(circle_at_bottom_right,_rgba(168,85,247,0.14),_transparent_30%)]"></div>
  <div class="absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-cyan-300/40 to-transparent"></div>
  <div class="absolute left-[-7rem] top-24 -z-10 h-72 w-72 rounded-full bg-cyan-400/10 blur-3xl"></div>
  <div class="absolute right-[-8rem] top-40 -z-10 h-80 w-80 rounded-full bg-violet-400/10 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-10">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.32em] text-cyan-100/70">
        Program
      </p>
      <h2
        id="schedule-title"
        class="mt-4 text-4xl font-semibold tracking-[-0.05em] text-balance text-white sm:text-5xl"
      >
        Workshop Schedule
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg">
        Bringing together academic and industry professionals while fostering communication and innovation through the sharing of varied research, industry experiences, and perspectives.
      </p>
    </div>

    <div class="mt-12 overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 shadow-[0_30px_90px_-40px_rgba(8,15,40,0.9)] backdrop-blur-xl">
      <div class="grid grid-cols-[7.5rem_minmax(0,1fr)] border-b border-white/10 bg-white/5 px-5 py-4 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-slate-300 sm:grid-cols-[11rem_minmax(0,1fr)] sm:px-8">
        <span>Time</span>
        <span>Events</span>
      </div>

      <div class="divide-y divide-white/10">
        {scheduleItems.map((item, index) => (
          <div class="grid grid-cols-[7.5rem_minmax(0,1fr)] gap-4 px-5 py-5 transition duration-300 hover:bg-white/5 sm:grid-cols-[11rem_minmax(0,1fr)] sm:px-8 sm:py-6">
            <div class="flex items-start">
              <span class="inline-flex min-h-10 items-center rounded-full border border-cyan-300/20 bg-cyan-300/10 px-3 py-1 text-sm font-semibold text-cyan-100 shadow-[0_0_0_1px_rgba(103,232,249,0.04)]">
                {item.time}
              </span>
            </div>

            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h3 class="text-lg font-semibold tracking-[-0.03em] text-white sm:text-xl">
                  {item.event}
                </h3>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-300">
                  Title Pending
                </p>
              </div>

              <div class="hidden shrink-0 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-slate-300 sm:inline-flex">
                {String(index + 1).padStart(2, "0")}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
