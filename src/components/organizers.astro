---
import organizerOne from "../../images/organizers/brady_moon.jpg";
import organizerTwo from "../../images/organizers/elijah_pettitt.jpg";
import organizerThree from "../../images/organizers/guillaume_sartoretti.png";
import organizerFour from "../../images/organizers/muqing_cao.png";
import organizerFive from "../../images/organizers/seungchan_kim.png";
import organizerSix from "../../images/organizers/shenghai_yuan.png";
import organizerSeven from "../../images/organizers/yuhong_cao.webp";

const organizers = [
  { image: organizerOne, name: "Brady Moon" },
  { image: organizerTwo, name: "Elijah Pettitt" },
  { image: organizerThree, name: "Guillaume Sartoretti" },
  { image: organizerFour, name: "Muqing Cao" },
  { image: organizerFive, name: "Seungchan Kim" },
  { image: organizerSix, name: "Shenghai Yuan" },
  { image: organizerSeven, name: "Yuhong Cao" },
];
---

<section
  id="organizers"
  aria-labelledby="organizers-title"
  class="relative isolate overflow-hidden bg-[linear-gradient(180deg,_#ffffff_0%,_#f8fafc_42%,_#eef2ff_100%)] py-20 text-slate-900 sm:py-24"
>
  <div class="absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-slate-300 to-transparent"></div>
  <div class="absolute left-[-7rem] top-16 -z-10 h-72 w-72 rounded-full bg-cyan-300/15 blur-3xl"></div>
  <div class="absolute right-[-8rem] top-24 -z-10 h-80 w-80 rounded-full bg-violet-300/15 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-10">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.32em] text-cyan-700/80">
        Behind the Workshop
      </p>
      <h2
        id="organizers-title"
        class="mt-4 text-4xl font-semibold tracking-[-0.05em] text-balance text-slate-950 sm:text-5xl"
      >
        Organizers
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
        Our committee members bring extensive experience from past workshops and competitions at conferences including IROS, ICRA, AAAI, and CDC.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
      {organizers.map((organizer) => (
        <article class="group relative overflow-hidden rounded-[2rem] border border-slate-200/80 bg-slate-950 shadow-[0_30px_80px_-40px_rgba(15,23,42,0.22)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_40px_95px_-45px_rgba(15,23,42,0.28)]">
          <div class="relative h-[28rem]">
            <img
              src={organizer.image.src}
              alt={`${organizer.name} portrait`}
              class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,_rgba(15,23,42,0.02)_0%,_rgba(15,23,42,0.18)_38%,_rgba(15,23,42,0.92)_100%)]"></div>

            <div class="absolute inset-x-0 top-0 flex items-start justify-between gap-3 p-5">
              <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-white/80 backdrop-blur">
                Organizer
              </span>
            </div>

            <div class="absolute inset-x-0 bottom-0 p-5">
              <div class="inline-flex items-center gap-2 rounded-full border border-violet-300/20 bg-violet-300/10 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.28em] text-violet-100 backdrop-blur">
                Organizer role placeholder
              </div>

              <h3 class="mt-4 text-2xl font-semibold tracking-[-0.03em] text-white">
                {organizer.name}
              </h3>

              <p class="mt-2 text-sm font-medium text-slate-200/85">
                Affiliation or committee title placeholder
              </p>

              <p class="mt-4 max-w-sm text-sm leading-6 text-slate-300">
                Replace this card with the confirmed organizer information, and use this space for a short role summary or bio note.
              </p>

              <div class="mt-5 flex flex-wrap gap-2 text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-slate-300">
                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">
                  Role placeholder
                </span>
                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">
                  Bio placeholder
                </span>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
