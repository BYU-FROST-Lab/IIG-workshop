---
import competitionImage from "../../images/competition_image.png";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const tracks = [
  {
    title: "Track 1: Single-robot indoor exploration",
    note: "Competitors who choose to enter track 1 must have a single robot efficiently explore an unknown indoor map and maximize the amount of useful information collected within the allotted budget.",
  },
  {
    title: "Track 2: Multi-robot coordinated indoor exploration",
    note: "Competitors who choose to enter track 2 must have a team of robots collaboratively explore the same unknown indoor map. The robots are expected to share information and coordinate their motion so as to reduce redundant coverage and improve exploration efficiency.",
  },
];
---

<section
  id="competition"
  aria-labelledby="competition-title"
  class="relative isolate overflow-hidden bg-[linear-gradient(180deg,_#eff6ff_0%,_#f8fafc_36%,_#ffffff_100%)] py-20 text-slate-900 sm:py-24"
>
  <div class="absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-slate-300 to-transparent"></div>
  <div class="absolute left-[-8rem] top-16 -z-10 h-80 w-80 rounded-full bg-cyan-300/15 blur-3xl"></div>
  <div class="absolute right-[-9rem] top-24 -z-10 h-96 w-96 rounded-full bg-indigo-300/15 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-10">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.32em] text-cyan-700/80">
        Competition
      </p>
      <h2
        id="competition-title"
        class="mt-4 text-4xl font-semibold tracking-[-0.05em] text-balance text-slate-950 sm:text-5xl"
      >
        Open-Source Simulation Competition Focused on Indoor Exploration
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
        The competition includes both single-robot and multi-robot tracks to highlight challenges in exploration performance, mission efficiency, and coordination under communication constraints. Competitors choose to enter either the single-robot track, or the multi-robot track, or both. If entering both tracks, competitors may submit a single method for both tracks or may submit a method for each track. Participant's algorithms will be evaluated based on coverage of previously unknown environments with the winners of the challenge presenting their approach as part of the workshop program and 1st and 2nd place receiving cash prizes.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <article class="overflow-hidden rounded-[2rem] border border-slate-200/80 bg-white shadow-[0_30px_90px_-45px_rgba(15,23,42,0.22)]">
        <div class="relative overflow-hidden bg-slate-950">
          <div class="absolute inset-0 bg-[linear-gradient(180deg,_rgba(15,23,42,0.08)_0%,_rgba(15,23,42,0.2)_100%)]"></div>
          <img
            src={competitionImage.src}
            alt="Competition placeholder banner"
            class="h-full w-full aspect-[16/9] object-cover object-center transition duration-700 hover:scale-[1.02]"
            loading="lazy"
          />
          <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
            <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-white backdrop-blur">
              Example Indoor Environment
            </div>
          </div>
        </div>

        <div class="border-t border-slate-200/80 p-6 sm:p-8">
          <div class="w-full">
            <div class="rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5">
              <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">
                Evaluation
              </p>
              <p class="mt-3 text-base leading-7 text-slate-700">
                Submissions will be evaluated in two rounds. The first round is optional and will provide ranking feedback on a limited portion of the held-back indoor map dataset. The second round is the final submission and will evaluate submissions on the entire held-back dataset. Of course, this testing dataset will not be provided and so participating in the optional feedback round is encouraged.
              </p>
            </div>
          </div>

          <div class="mt-6 space-y-4">
            {tracks.map((track) => (
              <div class="rounded-[1.5rem] border border-slate-200 bg-white p-5 shadow-[0_16px_40px_-30px_rgba(15,23,42,0.18)]">
                <h3 class="mt-2 text-xl font-semibold tracking-[-0.03em] text-slate-950">
                  {track.title}
                </h3>
                <p class="mt-3 text-base leading-7 text-slate-600">
                  {track.note}
                </p>
              </div>
            ))}
          </div>
        </div>
      </article>

      <aside class="space-y-6">
        <div class="overflow-hidden rounded-[2rem] border border-slate-200/80 bg-[linear-gradient(180deg,_#0f172a_0%,_#111827_100%)] p-6 text-white shadow-[0_30px_90px_-45px_rgba(15,23,42,0.5)] sm:p-8">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-cyan-100/70">
            Contribution
          </p>
          <h3 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white">
            The competition winners will present their method at the workshop.
          </h3>
          <p class="mt-4 text-sm leading-6 text-slate-300">
            Competitors are invited to join and submit methods to explore autonomously in an open-source indoor simulation environment. 
                
          </p>

          <div class="mt-6 space-y-3">
            <div class="rounded-[1.25rem] border border-white/10 bg-white/5 px-4 py-4">
              <p class="text-sm font-semibold text-white">Deadlines</p>
              <p class="mt-1 text-sm leading-6 text-slate-300">
                <strong class="font-semibold text-white">15 Aug:</strong> Optional Feedback Submission and Preliminary Rankings
              </p>
              <p class="mt-1 text-sm leading-6 text-slate-300">
                <strong class="font-semibold text-white underline">27 Aug: </strong> <strong class="font-semibold text-white underline italic">Final Submission</strong>
              </p>
              <p class="mt-1 text-sm leading-6 text-slate-300">
                <strong class="font-semibold text-white">3 Sept:</strong> Competition Results Released
              </p>

              <p class="mt-1 text-sm leading-6 text-slate-300">
                All deadlines are at 23:59 AoE (Anywhere on Earth)
              </p>
            </div>


            <a
              href="https://docs.google.com/forms/d/e/1FAIpQLSes1TAmSbyK-_Mf67V3xbOMDzQ8rFsn03Co6WadGIAfVyfGTA/viewform"
              class="flex items-center justify-center rounded-[1.25rem] border border-cyan-300/30 bg-cyan-400/15 px-4 py-4 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:bg-cyan-400/25"
            >
              Competition Registration
            </a>

            <a
              href={`${base}/competition`}
              class="flex items-center justify-center rounded-[1.25rem] border border-white/10 bg-white/5 px-4 py-4 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:bg-white/10"
            >
              View Instructions
            </a>

            <a
              href="https://github.com/BYU-FROST-Lab/indoor-exploration-competition"
              class="flex items-center justify-center rounded-[1.25rem] border border-white/10 bg-white/5 px-2 py-2 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:bg-white/10"
            >
              Github Repository
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
